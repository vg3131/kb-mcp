# Copy to .env (gitignored) and fill in. On Vercel, set these as
# Environment Variables instead; .env is only read for local runs.

# MongoDB Atlas. Locally: the READ-WRITE user (ingest.py writes).
# On Vercel: the READ-ONLY user. Use a letters-and-numbers password so it
# doesn't need URL-encoding.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority&appName=kb-mcp
MONGODB_DB=kb-mcp

# Voyage AI embeddings (dashboard.voyageai.com)
VOYAGE_API_KEY=

# Path to the markdown knowledge base, relative to this file's directory
# (or absolute). Defaults to worx-techtalk-markdown-kb inside mcp-server/.
KB_ROOT=worx-techtalk-markdown-kb

# Port for local runs (`python server.py`); unused on Vercel.
PORT=8000
